# --- runtime -------------------------------------------------------------
ECHO_ENV=development
ECHO_DATABASE_URL=sqlite+pysqlite:///./echo.db
# production: ECHO_DATABASE_URL=postgresql+psycopg://echo:pass@localhost:5432/echo

# Two independent signing keys: a user token can never satisfy an admin route.
ECHO_USER_JWT_SECRET=dev-user-jwt-secret-change-me
ECHO_ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me
ECHO_USER_TOKEN_TTL=43200
ECHO_ADMIN_TOKEN_TTL=900

# Memory content encryption key (generate: python -c "from app.core.crypto import new_data_key; print(new_data_key())")
# Required in production. Without it, content is stored as plaintext in development only.
ECHO_DATA_KEY=
# Retired keys may decrypt but never encrypt: the rotation window. Comma-separated,
# newest first. Set it only while rotating, then remove it (see README "Rotating the
# data key") and re-run the rotation check.
# ECHO_DATA_KEY_PREVIOUS=

ECHO_CORS_ORIGINS=http://localhost:5173

# --- email codes ---------------------------------------------------------
# Six digit codes verify a new address, can finish a sign-in, and reset a password
# (administrators never use email codes: their TOTP stays mandatory).
#
# With no provider set, codes are written to the API log instead of being sent, and
# local development hands the code back in the response so the flow can be walked
# without a mailbox. Production refuses to start like that.
ECHO_EMAIL_PROVIDER=
ECHO_RESEND_API_KEY=
ECHO_EMAIL_FROM="ECHO <codes@example.com>"  # quotes: < > are shell syntax
# Set to false only for a private instance where every account is trusted.
ECHO_EMAIL_VERIFICATION_REQUIRED=true
# Policy dials: six digits, five minutes, five wrong guesses, a minute between
# sends. Raise rather than lower these in production.
ECHO_EMAIL_CODE_TTL=300
ECHO_EMAIL_CODE_MAX_ATTEMPTS=5
ECHO_EMAIL_CODE_COOLDOWN=60
ECHO_EMAIL_CODE_HOURLY_PER_ADDRESS=5
ECHO_EMAIL_CODE_HOURLY_PER_IP=20
# Optional extra secret mixed into the stored code digest. Set it once; rotating it
# only invalidates codes that are in flight.
# ECHO_EMAIL_CODE_PEPPER=

# --- optional model provider --------------------------------------------
# Leave these unset and ECHO stays fully local: answers quote your memories and
# captures are extracted with rules. Set a key and the model may write the answer
# (still cited, or discarded) and read captures (still grounded, or discarded).
# Remember: with a provider on, retrieved note text is sent to that provider.
ECHO_LLM_PROVIDER=
ECHO_OPENAI_API_KEY=
ECHO_LLM_MODEL=gpt-4o-mini
ECHO_LLM_TIMEOUT=20
ECHO_LLM_EXTRACTION=true
# Any OpenAI-compatible server works, including a local model:
# ECHO_OPENAI_BASE_URL=http://localhost:11434/v1

# --- Reminder email ------------------------------------------------------------
# Reminder email is on by default: a promise with a date is not much use if the only
# reminder lives in an app you have to remember to open. Every message carries a
# one-click opt-out that needs no login, and the switch in the sidebar does the same
# thing. Delivery uses the same provider as the sign-in codes above; with no provider
# configured nothing is sent and the outbox row says so instead of pretending.
#
# These two addresses are what links in the email point at, so set them to the real
# deployment before sending anything: the app URL is "open your reminders", the API URL
# is the opt-out page.
ECHO_PUBLIC_APP_URL=http://127.0.0.1:5173
ECHO_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Notifications (Web Push) -------------------------------------------------
# Generate a keypair with: python -m app.scripts.vapid_keys
# The public half reaches browsers (that is expected); the private half stays here.
# Rotating the keypair invalidates every existing subscription.
ECHO_VAPID_PUBLIC_KEY=
ECHO_VAPID_PRIVATE_KEY=
# Contact address the push services can use if this server misbehaves.
ECHO_VAPID_SUBJECT=mailto:you@yourdomain.com
